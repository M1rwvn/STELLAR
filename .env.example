# Copy to .env and change the secrets. .env is git-ignored.

# Local run without Docker (Plan B) uses SQLite:
DATABASE_URL=sqlite:///./stellar.db
# With Docker, docker-compose.yml builds the PostgreSQL URL from these:
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro_dev_pw
POSTGRES_DB=stellar

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=720

# Development password for all seeded accounts (admin, doctor, ground, device, ethan, emily, ryan)
SEED_PASSWORD=astro123
SEED_ON_STARTUP=true

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated, e.g. http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# auto = use ai_modules/* when present, else stubs | stub | real
AI_MODE=auto

# Simulated space-to-ground one-way delay
COMM_DELAY_SECONDS=2
COMM_LINK_ENABLED=true
